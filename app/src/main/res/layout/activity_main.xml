<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/topBarLeftContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintEnd_toStartOf="@id/modeToggleButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/urlInputLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp">

            <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                android:id="@+id/urlEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bsl_address_bg"
                android:gravity="center_vertical"
                android:hint="@string/url_hint"
                android:includeFontPadding="false"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:overScrollMode="never"
                android:paddingHorizontal="12dp"
                android:scrollHorizontally="true"
                android:scrollbars="none"
                android:singleLine="true"
                android:completionThreshold="1"
                android:dropDownHeight="wrap_content"
                android:textSize="14sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/buttonsRow"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/backButton"
                style="@style/Widget.BSL.ToolbarIconButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_nav_back" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/forwardButton"
                style="@style/Widget.BSL.ToolbarIconButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:contentDescription="@string/cd_forward"
                android:src="@drawable/ic_nav_forward" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/reloadButton"
                style="@style/Widget.BSL.ToolbarIconButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:contentDescription="@string/cd_reload"
                android:src="@drawable/ic_nav_reload" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/recordPauseButton"
                style="@style/Widget.BSL.ToolbarIconButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:contentDescription="@string/cd_record_pause"
                android:src="@drawable/ic_record_dot"
                android:tint="@null" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/stopButton"
                style="@style/Widget.BSL.ToolbarIconButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:contentDescription="@string/cd_stop"
                android:enabled="false"
                android:alpha="0.45"
                android:src="@drawable/ic_stop_square" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/timeWarpButton"
                style="@style/Widget.BSL.ToolbarIconButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:contentDescription="@string/simulate_time"
                android:src="@drawable/ic_nav_time" />
        </LinearLayout>
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/modeToggleButton"
        style="@style/Widget.BSL.ToolbarIconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/cd_toggle_bar"
        android:src="@drawable/ic_toggle_cursor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.bankscraperlogger.ui.IntensityBarsView
        android:id="@+id/intensityView"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarLeftContainer" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/intensityView" />

    <FrameLayout
        android:id="@+id/lockOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/lockTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lock_title"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/pinInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/pinEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/pin_hint"
                        android:imeOptions="actionDone"
                        android:inputType="numberPassword"
                        android:maxLines="1"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/simulateTimeButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/simulate_time" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/unlockButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/unlock" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

